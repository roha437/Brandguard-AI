# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Supabase Client Configuration (Public / Browser-safe via Vite VITE_ prefix)
# ---------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# ---------------------------------------------------------------------------
# Supabase Server Configuration (Backend-only - NEVER expose to frontend)
# ---------------------------------------------------------------------------
# Optional overrides for server.ts; falls back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Strictly server-side privileged key (never prefix with VITE_ and never use in src/)
SUPABASE_SERVICE_ROLE_KEY=""

